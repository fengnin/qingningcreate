+
+function collectConflictCoreViolations(
+  seed: StorySeed,
+  cores: StoryConflictCores,
+  reviews: ConflictCoreContractReview[],
+): ConflictCoreContractViolation[] {
+  const reviewById = new Map(reviews.map((review) => [review.conflictCoreId, review]))
+  return cores.flatMap((core) => {
+    const review = requireReviewForCandidate(
+      reviewById,
+      core.id,
+      '模型审查结果没有覆盖全部冲突核心，请重试。',
+      'INVALID_CONFLICT_CORE_REVIEW',
+    )
+    const missing: ConflictCoreContractPart[] = []
+    if (!review.preservesLockedFacts) missing.push('lockedFacts')
+    if (seed.lockedGoal && !review.preservesLockedGoal) missing.push('lockedGoal')
+    if (!review.obstacleThreatensGoal) missing.push('goalThreat')
+    if (!review.hasSingleMechanism) missing.push('singleMechanism')
+    if (!review.requiresTradeoff) missing.push('tradeoff')
+    if (!review.staysWithinScope) missing.push('scope')
+    return missing.length ? [{ title: core.title, missingParts: missing }] : []
+  })
 }
 
