# Create a local .env file beside this example and set your DashScope API key.
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# Qwen Plus is the default. Keep this unless you deliberately want another model.
QWEN_MODEL=qwen-plus
PORT=8787

# Optional local acceptance mode. It skips network model calls and exercises
# the fact-preserving, explicitly labelled fallback proposals.
STORY_DISABLE_MODEL=false

# Optional diagnostic caps for isolated real-model verification. The request
# cap covers every Qwen HTTP call within one API request, including transport
# retries, response_format fallback, and recovery. Leave it unset in normal
# production traffic.
# STORY_QWEN_REQUEST_ATTEMPTS=1
STORY_MODEL_OUTPUT_ATTEMPTS=3
STORY_QWEN_DISABLE_RESPONSE_FORMAT_FALLBACK=false
STORY_QWEN_REQUEST_TIMEOUT_MS=90000

# Optional diagnostic only. Story-turn generation does not wait for this review
# by default, so a conservative reviewer cannot interrupt the reader's path.
STORY_TURN_GROUNDING_REVIEW=false

# Optional quality gate for completed stories. It is enabled by default and
# retries only when the model finds a conflict with confirmed story events.
# Set to false only while diagnosing generation behavior.
STORY_BODY_CONSISTENCY_REVIEW=true
